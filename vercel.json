{
  "redirects": [
    {
      "source": "/",
      "destination": "/welcome",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "functions": {
    "app/api/generate-portfolio/route.ts": {
      "maxDuration": 30
    },
    "app/api/post-me/route.ts": {
      "maxDuration": 30
    }
  }
} 